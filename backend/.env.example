# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Postgres
# Option A — hosted (e.g. Neon, Supabase): set DATABASE_URL and leave the DB_* fields below
# alone, they're ignored when this is set. Must include ?sslmode=require for Neon.
DATABASE_URL=

# Option B — local docker-compose Postgres: leave DATABASE_URL empty and use these instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=legalai
DB_PASSWORD=legalai_dev_password
DB_NAME=legalai

# Auth (session lives in an httpOnly cookie — see src/utils/authCookie.ts)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Google Cloud Vision (OCR for images / scanned PDFs)
# Path to a service account JSON key with Cloud Vision API access.
# Leave unset to disable OCR fallback (image uploads will be rejected with a clear error).
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
